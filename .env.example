# Copy to `.env` in the workspace root: `cp .env.example .env`
# (`.env` is gitignored; this file is the checked-in template.)

# Required. The app panics on startup without it.
# SQLite (simplest for local dev) — `mode=rwc` creates the file if missing:
DATABASE_URL=sqlite://data.sqlite?mode=rwc
# Postgres instead:
# DATABASE_URL=postgres://user:password@localhost/rusty_budgets

# Optional. Only used by the `api` migration binary, which copies a legacy
# JoyDB file into SQL on startup. Defaults to `data.json` in the working
# directory. Point it at an empty file (containing `{}`) to skip the copy.
# DATA_FILE=data.json
